# Project Atlas Environment Variables

# API Configuration
PROJECT_NAME="Project Atlas - AI Research Copilot"
API_PREFIX="/api/v1"
API_KEY="atlas-secret-key-2025"
REQUEST_TIMEOUT_SECONDS=30.0

# Database Configuration (Docker MySQL)
# Use this in docker-compose:
DATABASE_URL="mysql+pymysql://atlas_user:atlas_pass@mysql:3306/atlas_db"
# Or for local development without Docker:
# DATABASE_URL="sqlite:///atlas_local.db"

# Vector Store
CHROMA_PERSIST_DIRECTORY="data/vector_db"
CHROMA_COLLECTION_NAME="market_reports"

# Provider Configurations
EMBEDDING_PROVIDER="chroma_default" # Options: chroma_default, fastembed, sentence_transformers, gemini, openai
LLM_PROVIDER="deterministic"         # Options: deterministic, gemini, openai, ollama

# Optional API keys for cloud providers
GEMINI_API_KEY=""
OPENAI_API_KEY=""
OLLAMA_BASE_URL="http://localhost:11434"
LLM_MODEL="gemini-1.5-flash"

# Escalation Policy
ESCALATION_CONFIDENCE_THRESHOLD=0.70
